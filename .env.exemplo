# Copie para .env e preencha. O .env NUNCA vai para o repositório.
#
# Para sortear os dois valores longos, no servidor:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# A senha da tela de configuração. Escolha uma sua.
LUCAS_SENHA=

# O token que o Trilho manda no cabeçalho de cada chamada ao carteiro.
# É este que vai para a Vercel, na variável do lado de lá.
LUCAS_TOKEN=

# Assina o cookie da tela. Trocar derruba quem estiver logado, e nada mais.
LUCAS_SEGREDO=

# A chave da conta Anthropic do Lucas. Ela vive SÓ aqui: não vai para o Trilho,
# não vai para a Vercel, não passa por mais ninguém.
ANTHROPIC_API_KEY=

# A porta local. O nginx é quem atende de fora; isto nunca fica exposto.
LUCAS_PORTA=4310

# Opcional: outro modelo. O padrão é claude-sonnet-5-5.
# LUCAS_MODELO=

# Opcional: quanto o cérebro pode levar pensando, em milissegundos. O padrão é
# 22000, abaixo dos 25000 que o Trilho concede, para a resposta caber na volta.
# LUCAS_PRAZO_MS=
